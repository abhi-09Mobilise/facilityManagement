# =============================================================
# Embassy Pantry Bridge — environment template
# Copy to .env and fill in real values. Never commit the real .env.
# =============================================================

# --- Service config ---
PORT=4000
# Comma-separated list of allowed callers for CORS (usually the FM backend host).
# Use '*' only in dev.
CORS_ORIGIN=*

# Shared secret required in the X-Bridge-Secret header on every request.
# Generate: `node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"`
BRIDGE_SECRET=change-me-to-a-strong-random-hex

# --- Mode ---
# mock : return canned data in FM shape (useful on dev workstations that
#        can't reach the Embassy private subnet).
# live : hit the real Embassy MySQL and run the aggregator queries.
BRIDGE_MODE=live

# --- Embassy MySQL (used only when BRIDGE_MODE=live) ---
EMBASSY_DB_HOST=172.17.0.132
EMBASSY_DB_PORT=3306
EMBASSY_DB_USER=embassy_prod
EMBASSY_DB_PASSWORD="u.CoU6GV=e9T30qV-fnM2"
EMBASSY_DB_NAME=embassy_prod

# Set to 'true' for Azure MySQL Flexible Server (prod) which enforces TLS.
# When true, the pool loads BaltimoreCyberTrustRoot.crt.pem from this folder.
EMBASSY_DB_SSL=false

# Query timeout per request (ms). Protects the bridge from a stuck DB.
EMBASSY_DB_TIMEOUT_MS=8000
