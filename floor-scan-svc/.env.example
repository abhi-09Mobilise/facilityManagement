# Floor-scan microservice (FastAPI + OpenCV)
# Copy this to .env and tweak. Read by app.py via os.environ.

# ---------- Network ----------
# Bind address. Keep 127.0.0.1 in production so only the Node backend on
# the same machine can reach it. Use 0.0.0.0 only if Node runs on a
# different host inside a private network.
HOST=127.0.0.1
PORT=5001

# Comma-separated browser origins allowed by CORS. The browser NEVER hits
# this service directly in our setup (the Node API proxies /scan), so '*'
# is fine. If you ever expose it directly, set:
#   ALLOWED_ORIGINS=https://fms.onmobilise.com
ALLOWED_ORIGINS=*

# Max image upload (bytes). Default 10 MB.
MAX_UPLOAD_BYTES=10485760

# ---------- Detection tuning ----------
# Pixel area bounds — units = pixels at the image's native resolution.
CHAIR_MIN_PX_AREA=60
CHAIR_MAX_PX_AREA=500
TABLE_MIN_PX_AREA=2500
TABLE_MAX_PX_AREA=90000

# 0..1. Shapes above CIRCULARITY_THRESHOLD are classified as round tables.
CIRCULARITY_THRESHOLD=0.75

# 0..1. Contour-area / bounding-box-area must exceed this for rect tables.
RECT_FILL_THRESHOLD=0.85

# IoU threshold for the dedupe NMS pass.
DEDUPE_IOU=0.5

# ---------- AI provider (pluggable) ----------
# The /scan-ai endpoint routes to ONE of the vendors below. To swap providers
# in production, change AI_PROVIDER and populate that provider's API key +
# model name. No code changes are required. The frontend and Node backend
# don't know which vendor served the request.
#
#   AI_PROVIDER=gemini       # Google Gemini (default)
#   AI_PROVIDER=claude       # Anthropic Claude
#   AI_PROVIDER=openai       # OpenAI (ChatGPT / GPT-4o)
AI_PROVIDER=gemini

# ---------- Gemini (Google) ----------
GEMINI_ENABLED=true
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash
GEMINI_FALLBACK_MODEL=gemini-3.5-flash-lite
GEMINI_CALL_TIMEOUT_MS=15000

# ---------- Claude (Anthropic) ----------
CLAUDE_ENABLED=true
CLAUDE_API_KEY=
CLAUDE_MODEL=claude-sonnet-4-6
CLAUDE_FALLBACK_MODEL=claude-haiku-4-5
CLAUDE_CALL_TIMEOUT_MS=20000

# ---------- OpenAI (ChatGPT) ----------
OPENAI_ENABLED=true
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o
OPENAI_FALLBACK_MODEL=gpt-4o-mini
OPENAI_CALL_TIMEOUT_MS=20000

# ---------- Shared retry policy (applies to whichever provider is active) ----
# Bounded retries wrap the primary → fallback ladder. Non-retryable errors
# (400/401/403) break out immediately. Total worst-case latency stays under
# the Node backend's 90-second AbortController budget.
GEMINI_MAX_LADDER_RETRIES=1
GEMINI_RETRY_BASE_S=1.0
GEMINI_RETRY_MAX_S=4.0
